# ---------- 虚拟环境：391MB，且是 Windows 版解释器 ----------
.venv/

# ---------- 前端：独立工程，后端镜像不需要（含 node_modules） ----------
web/

# ---------- IDE 与编辑器 ----------
.idea/
.superdesign/
.vscode/

# ---------- 运行时产物：容器内会自己创建 ----------
logs/
**/__pycache__/
**/*.pyc
*.log

# ---------- 测试与本机专用脚本 ----------
tests/
start.ps1

# ---------- 密钥：绝对不能进镜像 ----------
.env
.env.*
*.key
*.pem

# ---------- 版本控制 ----------
.git/
.gitignore

# ---------- Docker 自身文件 ----------
Dockerfile
.dockerignore

# ---------- 说明文档：几 KB，可选 ----------
*.md
